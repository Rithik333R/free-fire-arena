# backend/.env.example
#
# Environment variable template for the backend API.
# Copy this file to .env and fill in all values before starting the server.
#
#   cp .env.example .env
#
# Never commit .env to version control.
# This file (.env.example) should always be committed.
#
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY — Before deploying to production:
#   1. Rotate MONGO_URI password in MongoDB Atlas
#   2. Generate a new JWT_SECRET (minimum 64 random bytes):
#      node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   3. Set CORS_ORIGIN to your actual frontend domain
#   4. Set NODE_ENV=production
#   5. Review JWT_EXPIRES_IN — shorten for higher security environments
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────

# Port the Express server listens on.
PORT=5000

# Node environment. Controls logging format, error detail level, and rate limiting.
# Values: development | production
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────

# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# Rotate the password before deploying to production.
MONGO_URI=mongodb+srv://root:CF2MJU6rf5SciUiT@cluster0.4mmzvkw.mongodb.net/authdb?retryWrites=true&w=majority
# ── Auth ──────────────────────────────────────────────────────────────────

# Secret key used to sign and verify JWT tokens.
# Must be a long random string — minimum 64 bytes recommended.
# Rotate before deploying to production.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=57f3f337bf862e14f30b1218a5b69ab9d323824447c75f414e0ceec451bb1a6bf32e99c870754a496441dc2f19f10cb4209eedc9ddab7304bd614225ec37a221
# JWT token expiry duration.
# Tokens older than this value will be rejected and the user must log in again.
#
# Format: number + unit suffix
#   "7d"   = 7 days    (recommended default)
#   "24h"  = 24 hours
#   "15m"  = 15 minutes (high security environments)
#   "30d"  = 30 days   (low friction, lower security)
#
# Phase F note: When refresh tokens are implemented, set this to "15m"
# and issue a separate long-lived refresh token in an httpOnly cookie.
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins.
# The API will reject browser requests from any other origin.
#
# Local development (Vite default):
CORS_ORIGIN=http://localhost:5174
#
# Production (replace with your actual domain):
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ── Rate Limiting (optional — defaults shown) ─────────────────────────────

# Auth endpoints (login, register) — tight limit to prevent brute force.
# Default: 10 attempts per 15 minutes per IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# General API — loose limit to prevent abuse.
# Default: 200 requests per 15 minutes per IP.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=200